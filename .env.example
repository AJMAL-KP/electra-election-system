# Electra Environment Configuration Example
# Copy this file to .env and adjust values as needed.

DEBUG=True
SECRET_KEY=change-this-in-production-django-insecure-electra-key
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF trusted origins for devices connecting over LAN (comma-separated, scheme required)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://192.168.1.100:8000

# PostgreSQL Database Configuration
DB_NAME=electra_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
