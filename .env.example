# Electra Environment Configuration Example
# Copy this file to .env and adjust values as needed.

DEBUG=True
SECRET_KEY=change-this-in-production-django-insecure-electra-key
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database Configuration
DB_NAME=electra_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
